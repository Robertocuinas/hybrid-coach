# Todas son opcionales. Sin ninguna, la aplicación arranca y funciona:
# pierde la capa de IA y el respaldo en la hoja, nada más.

# --- Autenticación ---
# Obligatoria. Genera un secreto aleatorio de al menos 32 caracteres.
SESSION_SECRET=
SESSION_TTL_DAYS=30
PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=5
# Peticiones de IA por minuto y cuenta. Protege el bolsillo de quien pone la
# clave y frena un bucle del cliente; no es una restriccion de producto.
# Solo cuenta lo que INVOCA a un modelo (generar semana, chat del Coach): leer la
# semana aceptada o listar conversaciones no consume cuota.
# Ponlo a 0 para desactivarlo del todo en una instancia de un solo usuario.
AI_RATE_LIMIT_PER_MINUTE=30
# Solo afecta a la subida por interfaz. La ingesta masiva por CLI
# (npm run biblio:ingest) no pasa por HTTP y no tiene este límite.
UPLOAD_RATE_LIMIT_PER_HOUR=60
AUTH_COOKIE_NAME=hc_session
# El alta pública está disponible por defecto. Ponlo en false si las cuentas
# pasan a crearse solo por invitación o durante una ventana de mantenimiento.
REGISTRATION_ENABLED=true
# Dominio público exacto de la app para validar mutaciones desde navegador.
APP_ORIGIN=
RECONCILIATION_ENABLED=true
# web: temporizador dentro del servidor; external: lo ejecuta un Railway Cron separado.
RECONCILIATION_MODE=web
# Webhook opcional; solo recibe estado y nombres de checks divergentes.
RECONCILIATION_WEBHOOK_URL=

# --- IA (opcional; sin LLM_PROVIDER la aplicación funciona sin IA) ---
# Las claves introducidas por cada usuario en Ajustes se cifran con esta clave.
# Si se deja vacía, se deriva de SESSION_SECRET. Cambiar el secreto utilizado
# invalida las claves de proveedor guardadas anteriormente.
AI_SETTINGS_ENCRYPTION_KEY=
# anthropic | openai | openai-compatible | ollama
LLM_PROVIDER=
LLM_MODEL=
# Obligatoria para anthropic/openai; opcional para servidores locales.
LLM_API_KEY=
# Para openai-compatible incluye /v1; para Ollama nativo usa http://127.0.0.1:11434
LLM_BASE_URL=
# Tope de tokens de SALIDA. Es el techo global: todas las tareas (planificador,
# coach, decisiones, ficha de PDF, resumen) derivan de aqui, asi que subirlo
# sube todo a la vez y no hay que tocar seis variables.
#
# 8000 por defecto. El valor anterior (1400) estaba pensado para un modelo
# pequeno y recortaba el JSON del planificador a media generacion. Un tope alto
# no cuesta nada mientras el modelo no lo use: solo se paga lo que genera.
# Con un modelo de ventana grande (gpt-4.1, Claude) puedes subirlo a 16000+.
LLM_MAX_TOKENS=8000

# Ajuste fino por tarea. Todas son OPCIONALES: sin definir se derivan del tope
# de arriba. Ninguna puede superarlo.
#   LLM_MAX_TOKENS_PLANIFICADOR  la semana entera en un JSON; es la mas larga
#   LLM_MAX_TOKENS_PLAN_MAESTRO  las 12 semanas completas; la salida mas grande
#                                de la aplicacion (suelo de 32000)
#   LLM_MAX_TOKENS_COACH         respuesta conversacional
#   LLM_MAX_TOKENS_DECISIONES    justificacion razonada con citas
#   LLM_MAX_TOKENS_PDF           ficha de un documento importado
#   LLM_MAX_TOKENS_RESUMEN       compactacion de la conversacion
#   LLM_MAX_TOKENS_PRUEBA        prueba de credenciales desde Ajustes
# Solo Ollama. Para el Coach redactor se recomienda false: evita consumir toda
# la salida en razonamiento interno antes de redactar la respuesta.
LLM_THINKING=false
OLLAMA_KEEP_ALIVE=5m
# Mantener false salvo que Ollama corra en un servicio privado controlado.
OLLAMA_ALLOW_REMOTE=false

# --- Modelo local de enrutado (opcional, no sustituye al LLM conversacional) ---
# Needle 2 clasifica llamadas de herramienta; no genera conversación libre.
TOOL_ROUTER_PROVIDER=
NEEDLE_BASE_URL=http://127.0.0.1:9475
NEEDLE_MIN_CONFIDENCE=0.85
NEEDLE_TIMEOUT_MS=15000
# Mantener false salvo que Needle corra en un servicio privado controlado.
NEEDLE_ALLOW_REMOTE=false

# --- Embeddings (opcional si no se usa retrieval; dimensión fija del proyecto) ---
# Se pueden configurar aquí o desde el panel de administración. Lo guardado en
# la base de datos MANDA sobre estas variables. Es un ajuste de instancia, no
# de cuenta: toda la biblioteca debe vectorizarse con el mismo modelo.
# Anthropic no ofrece embeddings; para Claude usa Voyage como pareja.
# voyage | openai | openai-compatible
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# Obligatoria para voyage/openai; opcional para servidores locales.
EMBEDDING_API_KEY=
# Obligatoria para openai-compatible, por ejemplo http://localhost:11434/v1
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=4

# --- Reranking (opcional; sin configurar se usa noop y no se reordena) ---
# noop | cohere | openai-compatible
RERANK_PROVIDER=noop
RERANK_MODEL=
# Obligatoria para cohere; opcional para servidores locales.
RERANK_API_KEY=
# Obligatoria para openai-compatible: servidor con POST {BASE_URL}/rerank
# (formato de Text Embeddings Inference / Jina). OpenAI NO tiene reranking.
RERANK_BASE_URL=

# --- Retrieval (RAG) ---
# Candidatos que se recuperan por componente antes de rerankear.
RAG_TOP_K_RETRIEVAL=25
# Fragmentos que acaban en el prompt.
RAG_TOP_K_FINAL=8
# Si los que superan el umbral son menos que esto, se completa con los mejores
# restantes marcados como "sin relación directa con la consulta".
RAG_MIN_RESULTS=3
# Por debajo de este score se responde "sin evidencia suficiente" y NO se llama
# al LLM. Con reranker es el score del reranker; con noop, la similitud coseno.
# Empieza permisivo y endurece con el dataset de la Fase 10.
RAG_MIN_SCORE=0.25
# Constante de Reciprocal Rank Fusion.
RAG_RRF_K=60
# Ponderar la fusión por grado de evidencia. Desactivado: mezcla relevancia con
# confianza y desplaza el umbral. Ver docs/05-rag.md §5.
RAG_WEIGHT_BY_GRADE=false

# --- Ventana de contexto de ENTRADA ---
# Cuanto texto se le entrega al modelo. A diferencia del tope de salida, aqui
# cada token se paga en todas las llamadas, asi que los valores son mas
# medidos. Todos son opcionales y estan acotados por los dos extremos en
# server/ai/limits.js: una variable mal puesta degrada, no rompe.

# Caracteres de cada fragmento de evidencia en el prompt del planificador. NO
# recorta cuantos fragmentos entran (eso sostiene la cobertura por consulta),
# solo cuanto texto de cada uno. Con 1200 se cortaba el fragmento antes del
# dato que sostenia la cita.
PLANNER_EVIDENCE_CHARS=3000

# Cuanto del intento rechazado se le devuelve al modelo al pedirle la
# reparacion. Recortarlo le hace reparar a ciegas la parte que no ve.
PLANNER_REPAIR_CHARS=60000

# Turnos de conversacion que viajan LITERALES, sin resumir, y a partir de
# cuantos mensajes se compacta. Un resumen pierde matices ("el dolor era al
# empezar y se iba al calentar" -> "tenia molestias") y esos matices son justo
# lo que cambia una recomendacion.
CHAT_TURNOS_LITERALES=24
CHAT_RESUMEN_UMBRAL=60

# Tope de espera de una llamada al LLM. El planificador genera un JSON con
# varias sesiones y tarda mucho mas que una respuesta de chat: con 45s se
# abortaban generaciones validas a medias.
LLM_TIMEOUT_MS=90000

# --- Google Sheets, camino 1: reenviar a tu Apps Script (recomendado) ---
APPS_SCRIPT_URL=

# --- Google Sheets, camino 2: escribir directamente (no hace falta si usas el 1) ---
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Strava ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Bloqueado por defecto: el flujo actual usa un token global en memoria y solo
# es aceptable temporalmente en una instancia estrictamente monousuario.
STRAVA_LEGACY_SINGLE_USER_ENABLED=false

# --- PostgreSQL ---
DATABASE_URL=
# auto | require | disable. Usa disable solo en una BD de pruebas cuyo servidor
# no soporte TLS; las conexiones públicas quedan cifradas en auto por defecto.
DATABASE_SSL=auto
PGVECTOR_ENABLED=true

# --- Cloudflare R2 (PDF original de la bibliografía) ---
# Opcional. Sin estas variables la ingesta funciona igual —texto, chunks y
# embeddings van a PostgreSQL— y solo se descarta el binario: la ficha no podrá
# abrir el original. Ponerlas a medias es peor que no ponerlas: la ingesta
# procesa el documento entero y falla al guardar. O las cuatro, o ninguna.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional: dominio propio del bucket para abrir el PDF sin pasar por el servidor.
R2_PUBLIC_BASE_URL=
# URLs firmadas de evidencia: entre 60 y 900 segundos (por defecto 300).
R2_SIGNED_URL_TTL_SECONDS=300
# Opcional: fuerza el endpoint S3 (pruebas locales). Por defecto se deriva de R2_ACCOUNT_ID.
R2_ENDPOINT=

# --- Alimentos (Open Food Facts) ---
# ACTIVADO por defecto: la API es abierta y no necesita clave. Ponlo en
# "ninguno" solo si quieres apagar la búsqueda de alimentos.
# La licencia ODbL exige identificarse en cada llamada: el User-Agent se
# construye desde APP_ORIGIN, así que conviene tenerlo configurado.
# Y exige atribución visible allí donde se muestren sus datos.
FOOD_PROVIDER=openfoodfacts
FOOD_LANG=es

# --- Catálogo de ejercicios (opcional) ---
# Sin EXERCISE_PROVIDER la aplicación sigue funcionando con los patrones de
# movimiento (PAT) y los ejercicios propios: el catálogo externo solo amplía
# las opciones, nunca decide la rutina.
# exercisedb
EXERCISE_PROVIDER=
EXERCISEDB_API_KEY=
# Solo para RapidAPI. Con host se firma como RapidAPI; sin él, acceso directo
# con Bearer. La URL base se deriva del host si no se indica.
EXERCISEDB_HOST=
EXERCISEDB_BASE_URL=

# --- Ingesta de PDF ---
# Solo si quieres forzar el intérprete. Vacío basta: se usa el entorno virtual
# .venv del proyecto (lo crea nixpacks.toml en el despliegue; en local,
# `python -m venv .venv` y `.venv/bin/pip install -r server/integrations/requirements.txt`).
PYTHON_BIN=
PDF_MAX_BYTES=52428800
PDF_EXTRACT_TIMEOUT_MS=120000

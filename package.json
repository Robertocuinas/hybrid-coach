{
  "name": "hybrid-coach",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Plan de media maratón con base de evidencia y módulo de nutrición",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test src/sync.test.js src/data/documentAdapter.test.js server/jobs/reconciliation.test.js server/routes/sync.persistence.test.js server/ai/providers/providers.test.js server/db/seed-biblio.test.js",
    "build": "node build.mjs",
    "start": "node server.js",
    "dev": "node build.mjs --watch & node server.js",
    "migrate": "node-pg-migrate up --migrations-dir ./server/db/migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir ./server/db/migrations",
    "migrate:data": "node migration/scripts/run.js",
    "seed:biblio": "node server/db/seed-biblio.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^144.0.0",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "csv-parse": "^6.0.0",
    "node-pg-migrate": "^7.0.0"
  }
}

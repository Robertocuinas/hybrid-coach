{
  "name": "hybrid-coach",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Plan de media maratón con base de evidencia y módulo de nutrición",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"src/**/*.test.js\" \"server/**/*.test.js\" \"scripts/**/*.test.js\" \"migration/**/*.test.js\"",
    "lint": "eslint .",
    "build": "node build.mjs",
    "start": "node server.js",
    "dev": "node build.mjs --watch & node server.js",
    "dev:db": "node scripts/dev-db.js",
    "migrate": "node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir ./server/db/migrations",
    "migrate:down": "node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migrations-dir ./server/db/migrations",
    "migrate:data": "node migration/scripts/run.js",
    "seed:biblio": "node server/db/seed-biblio.js",
    "biblio:ingest": "node scripts/ingest-biblio.js",
    "embeddings:reindex": "node migration/scripts/reindex-embeddings.js",
    "reconcile:once": "node server/jobs/reconciliation.js",
    "backup:db": "node migration/scripts/backup-database.js",
    "needle:serve": "node scripts/needle-python.js",
    "needle:smoke": "node scripts/needle-python.js --smoke",
    "qwen:smoke": "node scripts/qwen-smoke.js",
    "admin:grant": "node scripts/grant-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@bryllim/workout-guide": "^1.0.0",
    "@node-rs/argon2": "^2.0.2",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^174.0.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint/js": "^10.0.1",
    "csv-parse": "^6.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  }
}

{
  "name": "hybrid-coach",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Plan de media maratón con base de evidencia y módulo de nutrición",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.js",
